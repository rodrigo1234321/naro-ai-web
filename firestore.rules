rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // MVP: accesos abiertos para que los 2 usuarios compartan el CRM.
    // Para producción con cuentas individuales, sumar Firebase Auth y usar request.auth != null.
    match /clients/{clientId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
