// Main News Generator
async function generateNews() {
  console.log('📰 Obteniendo y procesando noticias frescas de CS2...');
  
  const hltvItems = await fetchRssItems(HLTV_RSS_NEWS);
  const googleItems = await fetchRssItems(GOOGLE_NEWS_CS2);

  const combinedRaw = [...hltvItems, ...googleItems];

  let freshArticles = [];

  if (combinedRaw.length > 0) {
    // Filter and clean RSS titles removing competitor names like "- TyC Sports"
    const cleanedRSS = combinedRaw.map((item, idx) => {
      const isArg = item.title.toLowerCase().includes('9z') || 
                    item.title.toLowerCase().includes('kru') || 
                    item.title.toLowerCase().includes('bestia') ||
                    item.title.toLowerCase().includes('argentina');

      const cleanTitle = cleanSourceFromTitle(item.title);
      const cleanSlug = cleanTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

      return {
        titulo: cleanTitle,
        bajada: item.description || 'Noticia de última hora y cobertura táctica en CS2 Noticia.',
        cuerpo: `${item.description || cleanTitle}\n\nNota publicada y analizada por el equipo editorial de CS2 Noticia (@cs2noticia). La escena competitiva de Counter-Strike 2 continúa generando novedades intensas en la temporada.`,
        categoria: isArg ? 'torneos' : (idx % 2 === 0 ? 'actualizaciones' : 'mercado'),
        autor: isArg ? 'Redacción CS2 Argentina' : 'Redacción CS2 Noticia',
        lectura: '4 min',
        slug: cleanSlug || `noticia-cs2-${idx}`,
        fecha: new Date().toISOString().split('T')[0],
        imagen: isArg 
          ? 'https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1200&q=80'
          : 'https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80',
        destacada: idx < 2,
        tags: ["CS2", "Esports", isArg ? "9z Team" : "HLTV"]
      };
    });

    // Deduplicate RSS entries
    const seenTitles = new Set();
    freshArticles = cleanedRSS.filter(art => {
      if (!art.titulo || seenTitles.has(art.titulo.toLowerCase())) return false;
      seenTitles.add(art.titulo.toLowerCase());
      return true;
    });
  }

  // Combine with POOL_ARTICLES to guarantee rich, non-repetitive CS2 content
  const combinedAll = [...freshArticles, ...POOL_ARTICLES];
  
  // Ensure unique slugs
  const finalArticles = [];
  const usedSlugs = new Set();

  for (const art of combinedAll) {
    if (!usedSlugs.has(art.slug)) {
      usedSlugs.add(art.slug);
      finalArticles.push(art);
    }
  }

  const newsToSave = finalArticles.slice(0, 10);

  fs.writeFileSync(NOTICIAS_FILE, JSON.stringify(newsToSave, null, 2), 'utf8');
  console.log(`💾 noticias.json actualizado con ${newsToSave.length} noticias frescas e inéditas.`);

  // Generate clean tweet draft for @cs2noticia
  if (newsToSave.length > 0) {
    const topStory = newsToSave[0];
    const articleUrl = `${SITE_URL}/noticia.html?slug=${topStory.slug}`;
    const tweetText = `🔥 ¡NUEVA NOTICIA EN CS2 NOTICIA! 🔥\n\n"${topStory.titulo}"\n\n📌 Lee la nota completa y el análisis táctico en nuestra web:\n👉 ${articleUrl}\n\n#CS2 #CounterStrike #Esports #9z @cs2noticia`;

    fs.writeFileSync(TWEET_FILE, tweetText, 'utf8');
    console.log(`✍️ Borrador de Tweet generado en tweet.txt:\n${tweetText}`);
  }
}

async function run() {
  console.log('🚀 CS2 Noticia — Pipeline de actualización periódica...');
  await updateMatches();
  await generateNews();
  console.log('🎉 Pipeline de noticias completado con éxito.');
}

