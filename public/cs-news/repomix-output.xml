  <script>
    let newsData = [];
    let matchesData = [];

    // Carga de Partidos en Vivo HLTV desde matches.json
    async function loadMatches() {
      const matchesGrid = document.getElementById('matchesGrid');
      try {
        const res = await fetch('matches.json');
        matchesData = await res.json();
      } catch (e) {
        matchesData = [
          { torneo: 'BLAST PREMIER', estado: 'PRÓXIMO', isLive: false, equipo1: 'Vitality', flag1: '🐝', equipo2: 'FaZe Clan', flag2: '🔴', score: 'VS' },
          { torneo: 'ESL PRO LEAGUE', estado: 'PRÓXIMO', isLive: false, equipo1: '9z Team', flag1: '🟣', equipo2: 'KRÜ Esports', flag2: '💖', score: 'VS' },
          { torneo: 'IEM CHINA', estado: 'RESULTADO', isLive: false, equipo1: '9z Team', flag1: '🟣', equipo2: 'Fnatic', flag2: '🟠', score: '2 - 0' }
        ];
      }

      matchesGrid.innerHTML = matchesData.map(m => `
        <div class="match-card ${m.destacado ? 'highlight' : ''}">
          <div class="match-league">
            <span>${m.torneo}</span>
            <span class="${m.isLive ? 'match-status-live' : ''}">${m.estado}</span>
          </div>
          <div class="match-teams">
            <span class="team-name">${m.flag1 || ''} ${m.equipo1}</span>
            <span class="score">${m.score}</span>
            <span class="team-name">${m.equipo2} ${m.flag2 || ''}</span>
          </div>
        </div>
      `).join('');
    }

    // Carga de noticias desde JSON
    async function loadNews() {
      try {
        const response = await fetch('noticias.json');
        if (!response.ok) throw new Error('Network error');
        newsData = await response.json();
      } catch (err) {
        newsData = [
          {
            titulo: "¡Bomba en el Sub-Tick! Valve lanza la mayor actualización táctica de CS2 de 2026",
            bajada: "El parche introduce mejoras masivas en el registro de disparos, ajustes al humo dinámico y el esperado regreso del mapa Train rediseñado.",
            categoria: "actualizaciones",
            autor: "Redacción CS2 Noticia",
            lectura: "4 min",
            slug: "actualizacion-masiva-sub-tick-cs2-train-regreso",
            fecha: "2026-07-22",
            imagen: "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80",
            destacada: true
          }
        ];
      }

      renderHero();
      renderNewsGrid('todas');
    }

    function renderHero() {
      const heroGrid = document.getElementById('heroGrid');
      if (!newsData.length) return;

      const mainStory = newsData[0];
      const sideStories = newsData.slice(1, 4);

      let html = `
        <a href="noticia.html?slug=${mainStory.slug}" class="hero-main-card">
          <img src="${mainStory.imagen}" alt="${mainStory.titulo}" class="hero-bg-img">
          <div class="hero-overlay"></div>
          <div class="hero-content">
            <span class="badge-cat ${mainStory.categoria}">${mainStory.categoria}</span>
            <h1 class="hero-title">${mainStory.titulo}</h1>
            <p class="hero-bajada">${mainStory.bajada}</p>
            <div class="hero-meta">
              <span>✍️ ${mainStory.autor}</span>
              <span>⏱️ ${mainStory.lectura}</span>
              <span>📅 ${mainStory.fecha}</span>
            </div>
          </div>
        </a>

        <div class="hero-side-grid">
          ${sideStories.map(story => `
            <a href="noticia.html?slug=${story.slug}" class="side-card">
              <img src="${story.imagen}" alt="${story.titulo}" class="side-card-img">
              <div class="side-card-body">
                <span class="badge-cat ${story.categoria}" style="align-self: flex-start; font-size: 0.7rem; padding: 0.2rem 0.5rem;">${story.categoria}</span>
                <h3 class="side-card-title">${story.titulo}</h3>
                <span style="font-size: 0.75rem; color: var(--text-dim);">📅 ${story.fecha}</span>
              </div>
            </a>
          `).join('')}
        </div>
      `;

      heroGrid.innerHTML = html;
    }

    function renderNewsGrid(catFilter = 'todas') {
      const newsGrid = document.getElementById('newsGrid');
      const filtered = catFilter === 'todas' 
        ? newsData 
        : newsData.filter(n => n.categoria === catFilter);

      if (!filtered.length) {
        newsGrid.innerHTML = `<p style="color: var(--text-muted); grid-column: 1/-1; text-align: center; padding: 3rem;">No se encontraron noticias en esta categoría.</p>`;
        return;
      }

      newsGrid.innerHTML = filtered.map(item => `
        <article class="news-card">
          <a href="noticia.html?slug=${item.slug}" class="card-img-wrap">
            <img src="${item.imagen}" alt="${item.titulo}" class="card-img" loading="lazy">
          </a>
          <div class="card-body">
            <div class="card-meta">
              <span class="badge-cat ${item.categoria}">${item.categoria}</span>
              <span style="font-size: 0.8rem; color: var(--text-dim);">⏱️ ${item.lectura}</span>
            </div>
            <h3 class="card-title">
              <a href="noticia.html?slug=${item.slug}">${item.titulo}</a>
            </h3>
            <p class="card-bajada">${item.bajada}</p>
            <div class="card-footer">
              <span>Por ${item.autor}</span>
              <span>${item.fecha}</span>
            </div>
          </div>
        </article>
      `).join('');
    }

    document.querySelectorAll('.filter-btn, .nav-link').forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat');
        if (!cat) return;
        setCategoryFilter(cat);
      });
    });

    function setCategoryFilter(cat) {
      document.querySelectorAll('.filter-btn, .nav-link').forEach(b => b.classList.remove('active'));
      document.querySelectorAll(`[data-cat="${cat}"]`).forEach(b => b.classList.add('active'));
      renderNewsGrid(cat);
    }

    // Theme Toggle Handler
    const themeToggle = document.getElementById('themeToggle');
    const sunIcon = themeToggle.querySelector('.sun-icon');
    const moonIcon = themeToggle.querySelector('.moon-icon');

    function updateThemeIcons(theme) {
      if (theme === 'light') {
        sunIcon.style.display = 'block';
        moonIcon.style.display = 'none';
      } else {
        sunIcon.style.display = 'none';
        moonIcon.style.display = 'block';
      }
    }

    themeToggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('cs2_theme', next);
      updateThemeIcons(next);
    });

    updateThemeIcons(document.documentElement.getAttribute('data-theme'));

    // Search Modal Handler
    const searchBtn = document.getElementById('searchBtn');
    const searchModal = document.getElementById('searchModal');
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');

    searchBtn.addEventListener('click', () => {
      searchModal.classList.add('active');
      searchInput.focus();
    });

    searchModal.addEventListener('click', (e) => {
      if (e.target === searchModal) searchModal.classList.remove('active');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') searchModal.classList.remove('active');
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        searchModal.classList.add('active');
        searchInput.focus();
      }
    });

    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      if (!query) {
        searchResults.innerHTML = '';
        return;
      }

      const matches = newsData.filter(n => 
        n.titulo.toLowerCase().includes(query) || 
        n.bajada.toLowerCase().includes(query) ||
        (n.tags && n.tags.some(t => t.toLowerCase().includes(query)))
      );

      if (!matches.length) {
        searchResults.innerHTML = `<p style="color: var(--text-muted); padding: 1rem;">No se encontraron resultados para "${query}".</p>`;
        return;
      }

      searchResults.innerHTML = matches.map(m => `
        <a href="noticia.html?slug=${m.slug}" style="display: block; background: var(--bg-card); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
          <div style="font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--text-main);">${m.titulo}</div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">${m.bajada.substring(0, 90)}...</div>
        </a>
      `).join('');
    });

    document.addEventListener('DOMContentLoaded', () => {
      loadMatches();
      loadNews();
    });
  </script>
</body>
</html>
