// Clean external news source suffixes (e.g. "- TyC Sports", "- Olé", "- Infobae")
function cleanSourceFromTitle(title) {
  if (!title) return '';
  return title
    .replace(/\s*-\s*[^-]+$/i, '')
    .replace(/\s*\|\s*.*$/, '')
    .trim();
}

function decodeHtml(str) {
  if (!str) return '';
  return str
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
}

// Fetch RSS helper with headers
async function fetchRssItems(url) {
  console.log(`🌐 Obteniendo feed RSS desde: ${url}`);
  try {
    const res = await fetch(url, { 
      headers: { 
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36',
        'Accept': 'application/rss+xml, application/xml, text/xml; q=0.9, */*; q=0.8'
      } 
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const xml = await res.text();

    const items = [];
    const itemRegex = /<item>([\s\S]*?)<\/item>/g;
    let match;

    while ((match = itemRegex.exec(xml)) !== null) {
      const content = match[1];
      const titleMatch = /<title>([\s\S]*?)<\/title>/.exec(content);
      const linkMatch = /<link>([\s\S]*?)<\/link>/.exec(content);
      const descMatch = /<description>([\s\S]*?)<\/description>/.exec(content);

      if (titleMatch && linkMatch) {
        const rawTitle = decodeHtml(titleMatch[1].replace(/<!\[CDATA\[(.*?)\]\]>/g, '$1').trim());
        const cleanedTitle = cleanSourceFromTitle(rawTitle);

        items.push({
          title: cleanedTitle,
          rawTitle: rawTitle,
          link: decodeHtml(linkMatch[1].replace(/<!\[CDATA\[(.*?)\]\]>/g, '$1').trim()),
          description: descMatch ? decodeHtml(descMatch[1].replace(/<!\[CDATA\[(.*?)\]\]>/g, '$1').replace(/<[^>]*>/g, '').trim()) : ''
        });
      }
    }
    return items;
  } catch (err) {
    console.warn(`⚠️ Advertencia al leer RSS ${url}:`, err.message);
    return [];
  }
}

