<file path=".github/workflows/update-news.yml">
name: CS2 Noticia - Auto Actualizar HLTV & X

on:
  schedule:
    # Se ejecuta automáticamente cada 4 horas
    - cron: '0 */4 * * *'
  workflow_dispatch: # Permite disparar la automatización manualmente desde la pestaña Actions en GitHub

# Otorgar permisos de escritura al token de GitHub Actions para permitir el git push
permissions:
  contents: write

jobs:
  update-news:
    runs-on: ubuntu-latest

    steps:
      - name: Clonar repositorio
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'

      - name: Instalar dependencias
        run: npm install

      - name: Ejecutar script de reposición de noticias de CS2 y HLTV
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          SITE_URL: ${{ vars.SITE_URL }}
        run: node scripts/update-news.js

      - name: Commitear y Subir cambios
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add package.json package-lock.json noticias.json matches.json tweet.txt
          # Solo hacer commit si hubo cambios en los archivos
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto: actualización de noticias HLTV y partidos" && git push)

      - name: Instalar navegador Chromium para Playwright
        run: npx playwright install chromium

      - name: Publicar Tweet en X (Twitter)
        env:
          TWITTER_AUTH_TOKEN: ${{ secrets.TWITTER_AUTH_TOKEN }}
          HEADLESS: 'true'
        run: node scripts/post-tweet.js

      - name: Mostrar Borrador de Tweet para X
        if: always()
        run: |
          if [ -f tweet.txt ]; then
            echo "### 🗞️ CS2 Noticia — Automatización de Noticias" >> $GITHUB_STEP_SUMMARY
            echo "El sitio web de CS2 Noticia (https://cs-news-seven.vercel.app/) se ha actualizado con éxito con información de HLTV." >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "#### 🐦 Borrador del Tweet para X (@cs2noticia):" >> $GITHUB_STEP_SUMMARY
            echo '```text' >> $GITHUB_STEP_SUMMARY
            cat tweet.txt >> $GITHUB_STEP_SUMMARY
            echo '' >> $GITHUB_STEP_SUMMARY
            echo '```' >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "*Tip: Si la cookie TWITTER_AUTH_TOKEN vence, puedes copiar este borrador y pegarlo directamente en tu cuenta.*" >> $GITHUB_STEP_SUMMARY
          else
            echo "### 🗞️ CS2 Noticia — Automatización de Noticias" >> $GITHUB_STEP_SUMMARY
            echo "No se encontraron nuevas noticias o no se pudo generar el borrador de Tweet." >> $GITHUB_STEP_SUMMARY
          fi
</file>

<file path="scripts/post-tweet.js">
/**
 * CS2 Noticia — Automated Twitter/X Poster via Playwright Stealth
 * Target account: https://x.com/cs2noticia (@cs2noticia)
 */

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const { chromium } = require('playwright-extra');
const stealthPlugin = require('puppeteer-extra-plugin-stealth');
const dotenv = require('dotenv');

dotenv.config();
chromium.use(stealthPlugin());

const USER_DATA_DIR = path.resolve(__dirname, '../twitter-session');
const TWEET_FILE = path.join(__dirname, '../tweet.txt');

async function run() {
  console.log('🤖 CS2 Noticia — Iniciando Automatización de Twitter/X via Playwright...');

  let tweetText = '';
  if (fs.existsSync(TWEET_FILE)) {
    tweetText = fs.readFileSync(TWEET_FILE, 'utf8').trim();
  }
  if (!tweetText) {
    tweetText = process.env.TWEET_TEXT || '';
  }

  if (!tweetText) {
    console.log('⚠️ No se encontró borrador de tweet en tweet.txt. Saltando.');
    return;
  }

  const isHeadless = process.env.HEADLESS === 'true';
  console.log(`🌐 Lanzando navegador Chromium (Headless: ${isHeadless})...`);

  const context = await chromium.launchPersistentContext(USER_DATA_DIR, {
    headless: isHeadless,
    args: [
      '--disable-blink-features=AutomationControlled',
      '--no-sandbox',
      '--disable-setuid-sandbox',
      '--disable-web-security'
    ],
    viewport: { width: 1280, height: 720 }
  });

  const page = context.pages()[0] || await context.newPage();

  try {
    const authToken = process.env.TWITTER_AUTH_TOKEN ? process.env.TWITTER_AUTH_TOKEN.trim() : '';

    if (authToken) {
      console.log('🔑 Inyectando cookies auth_token y ct0 en .x.com y .twitter.com...');
      const dummyCt0 = crypto.randomBytes(16).toString('hex');
      
      await context.addCookies([
        { name: 'auth_token', value: authToken, domain: '.x.com', path: '/', httpOnly: true, secure: true, sameSite: 'Lax' },
        { name: 'ct0', value: dummyCt0, domain: '.x.com', path: '/', httpOnly: false, secure: true, sameSite: 'Lax' },
        { name: 'auth_token', value: authToken, domain: '.twitter.com', path: '/', httpOnly: true, secure: true, sameSite: 'Lax' },
        { name: 'ct0', value: dummyCt0, domain: '.twitter.com', path: '/', httpOnly: false, secure: true, sameSite: 'Lax' }
      ]);
    }

    console.log('🔗 Navegando a X.com...');
    await page.goto('https://x.com/home', { waitUntil: 'domcontentloaded', timeout: 60000 });
    await page.waitForTimeout(5000);

    const currentUrl = page.url();
    console.log(`📍 URL actual: ${currentUrl}`);

    const isLoggedOut = currentUrl.includes('/login') || 
                        currentUrl.includes('/i/flow/login') || 
