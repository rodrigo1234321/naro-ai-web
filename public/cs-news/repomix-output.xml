<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title id="pageTitle">Noticia — CS2 Noticia</title>
  <meta name="description" content="Artículo detallado de CS2 Noticia — La fuente n°1 de Counter-Strike 2 en español.">
  <link rel="stylesheet" href="style.css">
  <script>
    {
      const savedTheme = localStorage.getItem('cs2_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    }
  </script>
</head>
<body>

  <!-- Reading Progress Bar -->
  <div class="progress-bar-wrap">
    <div class="progress-bar-fill" id="progressFill"></div>
  </div>

  <!-- HEADER -->
  <header>
    <div class="container header-inner">
      <a href="index.html" class="brand-logo">
        <div class="brand-icon">CS2</div>
        <div>CS2 <span>NOTICIA</span></div>
      </a>

      <div class="header-actions">
        <a href="index.html" class="filter-btn" style="display: flex; align-items: center; gap: 0.4rem;">
          ← Volver a la Portada
        </a>

        <button class="btn-icon" id="themeToggle" aria-label="Cambiar tema">
          <svg class="sun-icon" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" style="display: none;"><path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1z"/></svg>
          <svg class="moon-icon" width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12.3 22h-.1c-5.5 0-10-4.5-10-10 0-4.8 3.5-8.9 8.2-9.8.6-.1 1.2.3 1.3.9.1.6-.2 1.2-.8 1.4-2.9.9-4.9 3.7-4.9 6.9 0 4.1 3.4 7.5 7.5 7.5 3.2 0 6-2 6.9-4.9.2-.6.8-.9 1.4-.8.6.1 1 .7.9 1.3C21.2 18.5 17.1 22 12.3 22z"/></svg>
        </button>

        <a href="https://x.com/cs2noticia" target="_blank" rel="noopener noreferrer" class="btn-x-follow">
          @cs2noticia
        </a>
      </div>
    </div>
  </header>

  <!-- ARTICLE CONTAINER -->
  <main class="container">
    <article class="article-header" id="articleHeader">
      <!-- Carga dinámica -->
    </article>

    <div class="article-hero-img-wrap" id="articleImgWrap">
      <!-- Carga dinámica -->
    </div>

    <div class="article-container">
      <!-- Key Box Callout -->
      <div class="key-box">
        <h4>⚡ Puntos Clave de la Nota</h4>
        <ul style="padding-left: 1.2rem; color: var(--text-main);" id="keyPointsList">
          <li>Información verificada por el equipo de cobertura de CS2 Noticia.</li>
          <li>Reacciones directas de la escena profesional y creadores de contenido.</li>
          <li>Sigue las actualizaciones minuto a minuto en nuestra cuenta oficial de X <a href="https://x.com/cs2noticia" target="_blank" style="color: var(--amber-cs); font-weight: 700;">@cs2noticia</a>.</li>
        </ul>
      </div>

      <!-- Article Body -->
      <div class="article-body" id="articleBody">
        <!-- Renderizado dinámico -->
      </div>

      <!-- SHARE & ACTIONS -->
      <div style="margin: 3rem 0; padding: 1.5rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h4 style="font-family: var(--font-display); font-size: 1.2rem; font-weight: 800;">¿Te ha gustado este artículo?</h4>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Compártelo con tu escuadra y menciona a @cs2noticia en X.</p>
        </div>
        <div style="display: flex; gap: 0.8rem;">
          <button class="btn-x-follow" onclick="shareOnX()">
            Compartir en X
          </button>
          <button class="filter-btn" onclick="copyArticleLink()">
            📋 Copiar Enlace
          </button>
        </div>
      </div>

      <!-- COMMENTS SECTION -->
      <section style="margin-top: 4rem;">
        <h3 class="section-title" style="margin-bottom: 1.5rem;">Comentarios de la Comunidad</h3>
        
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.5rem; margin-bottom: 2rem;">
          <textarea id="commentText" style="width: 100%; height: 90px; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: var(--radius-sm); color: var(--text-main); padding: 0.8rem; font-family: var(--font-body); outline: none; margin-bottom: 1rem;" placeholder="Escribe tu opinión sobre esta noticia (ej. ¡Menudo nerf al M4A4!)..."></textarea>
          <button class="filter-btn active" onclick="postComment()" style="background: var(--amber-cs); color: #000;">Publicar Comentario</button>
        </div>

        <div id="commentsList" style="display: flex; flex-direction: column; gap: 1rem;">
          <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
              <strong style="font-family: var(--font-display); color: var(--amber-cs);">GamerPro_CS2</strong>
              <span style="font-size: 0.75rem; color: var(--text-dim);">Hace 15 minutos</span>
            </div>
            <p style="font-size: 0.95rem; color: var(--text-muted);">¡Excelente resumen! Ya era hora de que arreglaran la interpolación del sub-tick en Nuke.</p>
          </div>
        </div>
      </section>

      <!-- RELATED NEWS GRID -->
      <section style="margin-top: 4rem;">
        <h3 class="section-title" style="margin-bottom: 1.5rem;">Noticias Relacionadas</h3>
        <div class="news-grid" id="relatedGrid"></div>
      </section>
    </div>
  </main>

  <!-- FOOTER -->
  <footer>
    <div class="container">
      <div class="footer-bottom" style="border: none; padding: 0;">
        <p>© 2026 CS2 Noticia — Sigue a <a href="https://x.com/cs2noticia" target="_blank" style="color: var(--amber-cs);">@cs2noticia</a> en X para más información.</p>
        <a href="index.html" style="color: var(--text-muted);">Volver al Inicio ↑</a>
      </div>
    </div>
  </footer>

  <script>
    let currentArticle = null;
    let allNews = [];

    async function initArticle() {
      const params = new URLSearchParams(window.location.search);
      const slug = params.get('slug');

      try {
        const res = await fetch('noticias.json');
        allNews = await res.json();
      } catch (e) {
        allNews = [
          {
            titulo: "¡Bomba en el Sub-Tick! Valve lanza la mayor actualización táctica de CS2 de 2026",
            bajada: "El parche introduce mejoras masivas en el registro de disparos, ajustes al humo dinámico y el esperado regreso del mapa Train rediseñado.",
            cuerpo: "Valve ha tomado por sorpresa a la comunidad global de Counter-Strike 2 lanzando la actualización táctica más ambiciosa hasta la fecha. Con una descarga de 6.2 GB, los desarrolladores abordan las principales críticas que la escena profesional y casual venían señalando respecto al sistema sub-tick.\n\n### Principales novedades del parche:\n1. Overhaul del Sub-Tick: Ajuste completo a la interpolación de animación de los modelos de jugador.\n2. Humo Dinámico v2: Las granadas de humo ahora reaccionan de manera más realista.\n3. Regreso de de_train: El icónico mapa regresa bajo Source 2.",
            categoria: "actualizaciones",
            autor: "Redacción CS2 Noticia",
            lectura: "4 min",
            slug: "actualizacion-masiva-sub-tick-cs2-train-regreso",
            fecha: "2026-07-22",
            imagen: "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80"
          }
        ];
      }

      currentArticle = allNews.find(n => n.slug === slug) || allNews[0];

      // Actualizar Metas de la Página
      document.getElementById('pageTitle').innerText = `${currentArticle.titulo} — CS2 Noticia`;

      // Header de la nota
      document.getElementById('articleHeader').innerHTML = `
        <span class="badge-cat ${currentArticle.categoria}">${currentArticle.categoria}</span>
        <h1 class="article-title">${currentArticle.titulo}</h1>
        <p class="article-bajada">${currentArticle.bajada}</p>
        <div class="hero-meta" style="justify-content: center;">
          <span>✍️ Por ${currentArticle.autor}</span>
          <span>📅 ${currentArticle.fecha}</span>
          <span>⏱️ ${currentArticle.lectura} de lectura</span>
        </div>
      `;

      // Imagen principal
      document.getElementById('articleImgWrap').innerHTML = `
        <img src="${currentArticle.imagen}" alt="${currentArticle.titulo}" class="article-hero-img">
      `;

      // Cuerpo formateado de la nota
      const bodyHtml = currentArticle.cuerpo
        .split('\n\n')
        .map(paragraph => {
          if (paragraph.startsWith('### ')) {
            return `<h2>${paragraph.replace('### ', '')}</h2>`;
          }
          return `<p>${paragraph.replace(/\n/g, '<br>')}</p>`;
        })
        .join('');

      document.getElementById('articleBody').innerHTML = bodyHtml;

      // Noticias Relacionadas
      const related = allNews.filter(n => n.slug !== currentArticle.slug).slice(0, 3);
      document.getElementById('relatedGrid').innerHTML = related.map(item => `
        <article class="news-card">
          <a href="noticia.html?slug=${item.slug}" class="card-img-wrap">
            <img src="${item.imagen}" alt="${item.titulo}" class="card-img">
          </a>
          <div class="card-body">
            <span class="badge-cat ${item.categoria}" style="align-self: flex-start;">${item.categoria}</span>
            <h3 class="card-title" style="font-size: 1.1rem; margin-top: 0.5rem;">
              <a href="noticia.html?slug=${item.slug}">${item.titulo}</a>
            </h3>
          </div>
        </article>
      `).join('');
    }

    // Progress Bar Scroll Handler
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      document.getElementById('progressFill').style.width = scrolled + '%';
    });

    // Compartir en X
    function shareOnX() {
      const text = encodeURIComponent(`Noticia clave de CS2: "${currentArticle.titulo}" vía @cs2noticia`);
      const url = encodeURIComponent(window.location.href);
      window.open(`https://x.com/intent/tweet?text=${text}&url=${url}`, '_blank');
    }

    // Copiar enlace
    function copyArticleLink() {
      navigator.clipboard.writeText(window.location.href);
      alert('¡Enlace copiado al portapapeles!');
    }

    // Publicar comentario local
    function postComment() {
      const txt = document.getElementById('commentText').value.trim();
      if (!txt) return;

      const commentsList = document.getElementById('commentsList');
      const newComment = document.createElement('div');
      newComment.style.cssText = 'background: var(--bg-card); border: 1px solid var(--amber-cs); border-radius: var(--radius-sm); padding: 1rem;';
      newComment.innerHTML = `
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
          <strong style="font-family: var(--font-display); color: var(--amber-cs);">Tú (Lector CS2)</strong>
          <span style="font-size: 0.75rem; color: var(--text-dim);">Ahora mismo</span>
        </div>
        <p style="font-size: 0.95rem; color: var(--text-main);">${txt}</p>
      `;
      commentsList.prepend(newComment);
      document.getElementById('commentText').value = '';
    }

    // Theme Toggle
    const themeToggle = document.getElementById('themeToggle');
    themeToggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('cs2_theme', next);
    });

    document.addEventListener('DOMContentLoaded', initArticle);
  </script>
</body>
</html>
</file>

